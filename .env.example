# Database configuration
# The application uses SQLite by default. 
# To use PostgreSQL, provide a valid DATABASE_URL.
DATABASE_URL=postgres://user:password@localhost:5432/xyz

# Alternative individual fields (if needed by other parts of the app)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=user
# DB_PASSWORD=password
# DB_NAME=db

# Webhook configuration (Optional)
# Global n8n webhook settings for lead notifications
N8N_HOST=localhost
N8N_PORT=5678
N8N_WEBHOOK_PATH=/webhook/dc5412a0-adf8-4caa-93c5-a5fe586a3414
